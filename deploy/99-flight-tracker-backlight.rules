# Flight Tracker: let the video group (ft-server) write the panel backlight.
# DSI Waveshare nodes are typically named like 10-0045 or 11-0045 (I2C bus-address).
ACTION=="add", SUBSYSTEM=="backlight", TEST=="brightness", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
