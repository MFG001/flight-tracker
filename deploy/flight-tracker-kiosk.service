[Unit]
Description=Flight Tracker kiosk by Maverick Field Gear
After=flight-tracker.service graphical.target
Wants=flight-tracker.service

[Service]
Type=simple
User=@USER@
Group=@USER@
Environment=FLIGHT_TRACKER_URL=http://127.0.0.1:8741/?kiosk=1
ExecStart=/opt/flight-tracker/current/scripts/kiosk.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
